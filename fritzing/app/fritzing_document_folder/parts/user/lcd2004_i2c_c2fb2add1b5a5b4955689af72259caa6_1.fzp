<?xml version='1.0' encoding='UTF-8'?>
<module referenceFile="LCD2004-I2C.fzp" moduleId="lcd2004_i2c_c2fb2add1b5a5b4955689af72259caa6_1" fritzingVersion="0.9.3b">
 <version>1</version>
 <date>lun ago 24 2026</date>
 <author>giacomo</author>
 <description>A standard character display with 4x20 characters. Comes in many colors with LCM2004 IIC attached.</description>
 <title>LCD2004-I2C</title>
 <label></label>
 <tags>
  <tag>liquid crystal</tag>
  <tag>lcd</tag>
  <tag>display</tag>
  <tag>line display</tag>
  <tag>i2c</tag>
  <tag>character display</tag>
  <tag>screen</tag>
 </tags>
 <properties>
  <property name="family">lcd display</property>
  <property name="variant">20x4</property>
  <property name="columns">20</property>
  <property name="layer"></property>
  <property name="pin">4</property>
  <property name="part number"></property>
  <property name="rows">4</property>
 </properties>
 <views>
  <breadboardView>
   <layers image="breadboard/lcd2004_i2c_848bd97072c0d2f5afe7dc1ed1c9dd88_1_breadboard.svg">
