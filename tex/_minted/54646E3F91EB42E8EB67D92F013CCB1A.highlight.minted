\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+cm}{/**}
\PYG{c+cm}{ * @file sht20.h}
\PYG{c+cm}{ * @author Giacomo Simonetto}
\PYG{c+cm}{ * @brief Gestione del sensore SHT20}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Dichiarazione delle funzioni per la gestione del sensore SHT20.}
\PYG{c+cm}{ */}

\PYG{c+cp}{\PYGZsh{}ifndef SHT20\PYGZus{}H}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}H}

\PYG{c+cp}{\PYGZsh{}include}\PYG{+w}{ }\PYG{c+cpf}{\PYGZlt{}Arduino.h\PYGZgt{}}
\PYG{c+cp}{\PYGZsh{}include}\PYG{+w}{ }\PYG{c+cpf}{\PYGZlt{}SHT2x.h\PYGZgt{}}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Classe per la gestione non bloccante del sensore SHT20.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Per un corretto funzionamento, è necessario invocare la funzione update().}
\PYG{c+cm}{ * ad ogni iterazione del loop principale. Tale funzione gestisce in maniera}
\PYG{c+cm}{ * automatica le operazioni da eseguire in base allo stato del sensore.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Al termine di ogni invocazione di update() in base al valore restituito}
\PYG{c+cm}{ * da tale funzione, si consigliano le seguenti azioni:}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * \PYGZhy{} false: non sono disponibili nuovi dati o si è verificato un errore,}
\PYG{c+cm}{ *          è consigliato verificare il codice di errore tramite get\PYGZus{}error()}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * \PYGZhy{} true: sono disponibili nuovi dati per la temperatura e l\PYGZsq{}umidità,}
\PYG{c+cm}{ *         procedere con la lettura di entrambi i valori tramite le funzioni}
\PYG{c+cm}{ *         get\PYGZus{}temperature() e get\PYGZus{}humidity() il prima possibile, non verrà}
\PYG{c+cm}{ *         effettuata la richiesta di nuovi dati finché quelli disponibili}
\PYG{c+cm}{ *         non saranno stati letti}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Per un corretto funzionamento del timer di lettura del sensore SHT20, è}
\PYG{c+cm}{ * necessario resettare il timer di lettura del sensore tramite la funzione}
\PYG{c+cm}{ * init\PYGZus{}timer() prima della prima lettura del sensore o se il sensore non è}
\PYG{c+cm}{ * stato utilizzato per un periodo di tempo superiore al periodo di lettura}
\PYG{c+cm}{ * impostato. La prima lettura successiva avverrà dopo il periodo di lettura}
\PYG{c+cm}{ * impostato dall\PYGZsq{}invocazione di init\PYGZus{}timer().}
\PYG{c+cm}{ */}
\PYG{k}{class}\PYG{+w}{ }\PYG{n+nc}{sht20}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{k}{public}\PYG{o}{:}
\PYG{+w}{    }\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Costruttore della classe sht20.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * Riceve come parametro opzionale il tempo di campionamento, ovvero}
\PYG{c+cm}{     * l\PYGZsq{}intervallo di tempo tra due letture consecutive del sensore, espresso}
\PYG{c+cm}{     * in millisecondi. Di default viene impostato a 1000 ms (1 secondo).}
\PYG{c+cm}{     * Il datasheet consiglia di non scendere sotto al secondo per evitare}
\PYG{c+cm}{     * fenomeni di self\PYGZhy{}heating del sensore.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * È possibile indicare, sempre come parametro opzionale, il puntatore}
\PYG{c+cm}{     * all\PYGZsq{}oggetto TwoWire da utilizzare per la comunicazione I2C. Questo}
\PYG{c+cm}{     * è utile nel caso in cui il sensore sia attaccato ad un bus I2C diverso}
\PYG{c+cm}{     * da quello di default, ad esempio se in quello di default sono presenti}
\PYG{c+cm}{     * altri dispositivi I2C con lo stesso indirizzo (es. un altro SHT20).}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * @param read\PYGZus{}period periodo di lettura del sensore}
\PYG{c+cm}{     * @param wire puntatore all\PYGZsq{}oggetto TwoWire per la comunicazione I2C}
\PYG{c+cm}{     */}
\PYG{+w}{    }\PYG{n}{sht20}\PYG{p}{(}\PYG{k+kt}{uint32\PYGZus{}t}\PYG{+w}{ }\PYG{n}{read\PYGZus{}period}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{1000}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{TwoWire}\PYG{+w}{ }\PYG{o}{*}\PYG{n}{wire}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{Wire}\PYG{p}{);}

\PYG{+w}{    }\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Inizializzazione del sensore SHT20.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * @return true se l\PYGZsq{}inizializzazione è andata a buon fine}
\PYG{c+cm}{     * @return false se si è verificato un errore}
\PYG{c+cm}{     */}
\PYG{+w}{    }\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n+nf}{begin}\PYG{p}{();}

\PYG{+w}{    }\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Inizializza il timer per la lettura del sensore SHT20.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * La funzione inizializza il timer per la lettura del sensore SHT20,}
\PYG{c+cm}{     * in modo da eliminare eventuali offset temporali precedenti alla prima}
\PYG{c+cm}{     * lettura o dovuti ad un periodo di inattività del sensore superiore al}
\PYG{c+cm}{     * periodo di lettura impostato.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * La lettura successiva avverrà alla prima successiva invocazione della}
\PYG{c+cm}{     * funzione update().}
\PYG{c+cm}{     */}
\PYG{+w}{    }\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{init\PYGZus{}timer}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{      }\PYG{n}{read\PYGZus{}timer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{millis}\PYG{p}{()}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{read\PYGZus{}period}\PYG{p}{;}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}

\PYG{+w}{    }\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Effettua l\PYGZsq{}aggiornamento dello stato del sensore SHT20.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * La funzione gestisce in autonomia le operazioni da eseguire in base}
\PYG{c+cm}{     * allo stato del sensore, per cui va invocata ad ogni iterazione del}
\PYG{c+cm}{     * loop principale.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * Se non sono disponibili nuovi dati per la temperatura e l\PYGZsq{}umidità, la}
\PYG{c+cm}{     * funzione restituisce false ed è possibile verificare se si è verificato}
\PYG{c+cm}{     * un errore invocando la funzione get\PYGZus{}error(). L\PYGZsq{}errore viene resettato}
\PYG{c+cm}{     * a 0 al successivo aggiornamento con successo dello stato del sensore,}
\PYG{c+cm}{     * per cui è necessario leggere il codice di errore prima di invocare}
\PYG{c+cm}{     * nuovamente la funzione update().}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * Se sono disponibili nuovi dati per la temperatura e l\PYGZsq{}umidità, la}
\PYG{c+cm}{     * funzione restituisce true ed è necessario leggere entrambi i valori}
\PYG{c+cm}{     * il prima possibile, altrimenti non verranno effettuate nuove richieste}
\PYG{c+cm}{     * di lettura di nuovi dati.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * @return true nuovi dati disponibili per la temperatura e l\PYGZsq{}umidità}
\PYG{c+cm}{     * @return false nessun nuovo dato disponibile o si è verificato un errore}
\PYG{c+cm}{     */}
\PYG{+w}{    }\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n+nf}{update}\PYG{p}{();}

\PYG{+w}{    }\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Restituisce la temperatura misurata dal sensore SHT20.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * @return float temperatura misurata in gradi Celsius}
\PYG{c+cm}{     */}
\PYG{+w}{    }\PYG{k+kt}{float}\PYG{+w}{ }\PYG{n+nf}{get\PYGZus{}temperature}\PYG{p}{();}

\PYG{+w}{    }\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Restituisce l\PYGZsq{}umidità misurata dal sensore SHT20.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * @return float umidità misurata in percentuale}
\PYG{c+cm}{     */}
\PYG{+w}{    }\PYG{k+kt}{float}\PYG{+w}{ }\PYG{n+nf}{get\PYGZus{}humidity}\PYG{p}{();}

\PYG{+w}{    }\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Restituisce il codice di errore del sensore SHT20.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * Il codice di errore è disponibile fino alla successiva invocazione}
\PYG{c+cm}{     * con successo della funzione update(), che lo resetta a 0. Quindi per}
\PYG{c+cm}{     * verificare l\PYGZsq{}esito di una invocazione di update() è necessario leggere}
\PYG{c+cm}{     * il codice di errore prima di invocare nuovamente tale funzione.}
\PYG{c+cm}{     *}
\PYG{c+cm}{     * @return int codice di errore}
\PYG{c+cm}{     */}
\PYG{+w}{    }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n+nf}{get\PYGZus{}error}\PYG{p}{();}

\PYG{+w}{  }\PYG{k}{private}\PYG{o}{:}
\PYG{+w}{    }\PYG{n}{SHT2x}\PYG{+w}{ }\PYG{n}{sensor}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// oggetto della classe SHT2x per la gestione del sensore SHT20}
\PYG{+w}{    }\PYG{k+kt}{uint32\PYGZus{}t}\PYG{+w}{ }\PYG{n}{read\PYGZus{}period}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// periodo di lettura del sensore SHT20}
\PYG{+w}{    }\PYG{k+kt}{uint32\PYGZus{}t}\PYG{+w}{ }\PYG{n}{read\PYGZus{}timer}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// timer per le letture del sensore SHT20}
\PYG{+w}{    }\PYG{k+kt}{uint16\PYGZus{}t}\PYG{+w}{ }\PYG{n}{error}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// codice di errore del sensore SHT20}
\PYG{+w}{    }\PYG{k+kt}{uint8\PYGZus{}t}\PYG{+w}{ }\PYG{n}{state}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// stato del sensore SHT20}
\PYG{p}{\PYGZcb{};}

\PYG{c+cp}{\PYGZsh{}endif }\PYG{c+c1}{// SHT20\PYGZus{}H}
\end{MintedVerbatim}
