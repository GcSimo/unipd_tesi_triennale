\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Gestione dello stato del sensore SHT20.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Il sensore viene trattato come una macchina con i seguenti 6 stati finiti}
\PYG{c+cm}{ * che si susseguono in sequenza ciclica, con il seguente ordine:}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 0. SHT20\PYGZus{}IDLE:}
\PYG{c+cm}{ *   \PYGZhy{} il sensore è in pausa e non è in corso alcuna lettura}
\PYG{c+cm}{ *   \PYGZhy{} passa a SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}TEMP\PYGZus{}REQ dopo 1 secondo dall\PYGZsq{}ultima lettura}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 1. SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}TEMP\PYGZus{}REQ:}
\PYG{c+cm}{ *   \PYGZhy{} il sensore è pronto per ricevere la richiesta di lettura della temperatura}
\PYG{c+cm}{ *   \PYGZhy{} passa a SHT20\PYGZus{}WAIT\PYGZus{}TEMP dopo aver inviato la richiesta di lettura della temperatura}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 2. SHT20\PYGZus{}WAIT\PYGZus{}TEMP:}
\PYG{c+cm}{ *    \PYGZhy{} il sensore è in attesa della risposta alla richiesta di lettura della temperatura}
\PYG{c+cm}{ *    \PYGZhy{} passa a SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}RH\PYGZus{}REQ dopo aver ricevuto la risposta}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 3. SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}RH\PYGZus{}REQ:}
\PYG{c+cm}{ *    \PYGZhy{} il sensore è pronto per ricevere la richiesta di lettura dell\PYGZsq{}umidità}
\PYG{c+cm}{ *    \PYGZhy{} passa a SHT20\PYGZus{}WAIT\PYGZus{}RH dopo aver inviato la richiesta di lettura dell\PYGZsq{}umidità}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 4. SHT20\PYGZus{}WAIT\PYGZus{}RH:}
\PYG{c+cm}{ *    \PYGZhy{} il sensore è in attesa della risposta alla richiesta di lettura dell\PYGZsq{}umidità}
\PYG{c+cm}{ *    \PYGZhy{} passa a SHT20\PYGZus{}NEW\PYGZus{}DATA dopo aver ricevuto la risposta}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 5. SHT20\PYGZus{}NEW\PYGZus{}DATA:}
\PYG{c+cm}{ *    \PYGZhy{} il sensore ha nuovi dati disponibili per la temperatura e l\PYGZsq{}umidità}
\PYG{c+cm}{ *    \PYGZhy{} passa a SHT20\PYGZus{}TEMP\PYGZus{}READ o SHT20\PYGZus{}RH\PYGZus{}READ dopo aver letto uno dei due valori}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 6. SHT20\PYGZus{}TEMP\PYGZus{}READ:}
\PYG{c+cm}{ *    \PYGZhy{} la temperatura è stata letta dal sensore}
\PYG{c+cm}{ *    \PYGZhy{} passa a SHT20\PYGZus{}IDLE dopo aver letto anche l\PYGZsq{}umidità}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * 7. SHT20\PYGZus{}RH\PYGZus{}READ:}
\PYG{c+cm}{ *    \PYGZhy{} l\PYGZsq{}umidità è stata letta dal sensore}
\PYG{c+cm}{ *    \PYGZhy{} passa a SHT20\PYGZus{}IDLE dopo aver letto anche la temperatura}
\PYG{c+cm}{ */}

\PYG{c+c1}{// stati del sensore SHT20}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}IDLE 0               }\PYG{c+c1}{// sensore in pausa}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}TEMP\PYGZus{}REQ 1 }\PYG{c+c1}{// pronto per richiedere la temperatura}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}WAIT\PYGZus{}TEMP 2          }\PYG{c+c1}{// in attesa di ricevere la temperatura}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}RH\PYGZus{}REQ 3   }\PYG{c+c1}{// pronto per richiedere l\PYGZsq{}umidità}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}WAIT\PYGZus{}RH 4            }\PYG{c+c1}{// in attesa di ricevere l\PYGZsq{}umidità}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}NEW\PYGZus{}DATA 5           }\PYG{c+c1}{// nuovi dati disponibili dal sensore}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}TEMP\PYGZus{}READ 6         }\PYG{c+c1}{// temperatura letta dal sensore}
\PYG{c+cp}{\PYGZsh{}define SHT20\PYGZus{}RH\PYGZus{}READ 7           }\PYG{c+c1}{// umidità letta dal sensore}

\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{} implementazione della classe sht20 \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}

\PYG{c+c1}{// costruttore della classe sht20}
\PYG{n}{sht20}\PYG{o}{::}\PYG{n}{sht20}\PYG{p}{(}\PYG{k+kt}{uint32\PYGZus{}t}\PYG{+w}{ }\PYG{n}{rp}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{n}{sensor}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{SHT2x}\PYG{p}{();}\PYG{+w}{   }\PYG{c+c1}{// inizializzazione oggetto della classe SHT2x}
\PYG{+w}{  }\PYG{n}{state}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{SHT20\PYGZus{}IDLE}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// stato del sensore SHT20}
\PYG{+w}{  }\PYG{n}{read\PYGZus{}period}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{rp}\PYG{p}{;}\PYG{+w}{   }\PYG{c+c1}{// periodo di lettura del sensore SHT20}
\PYG{+w}{  }\PYG{n}{read\PYGZus{}timer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0UL}\PYG{p}{;}\PYG{+w}{   }\PYG{c+c1}{// timer per le letture del sensore SHT20}
\PYG{+w}{  }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0U}\PYG{p}{;}\PYG{+w}{         }\PYG{c+c1}{// codice di errore del sensore SHT20}
\PYG{p}{\PYGZcb{}}

\PYG{c+c1}{// inizializzazione del sensore SHT20}
\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n}{sht20}\PYG{o}{::}\PYG{n}{begin}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{c+c1}{// inizializzazione del sensore SHT20 e verifica errori}
\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{begin}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{getError}\PYG{p}{();}
\PYG{+w}{    }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}
\PYG{+w}{  }\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{    }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{true}\PYG{p}{;}
\PYG{+w}{  }\PYG{p}{\PYGZcb{}}
\PYG{p}{\PYGZcb{}}

\PYG{c+c1}{// aggiorna lo stato del sensore SHT20}
\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n}{sht20}\PYG{o}{::}\PYG{n}{update}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{k}{switch}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{state}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{} 0. sensore in attesa}
\PYG{+w}{    }\PYG{k}{case}\PYG{+w}{ }\PYG{n+no}{SHT20\PYGZus{}IDLE}\PYG{p}{:}
\PYG{+w}{      }\PYG{c+c1}{// verifica se sia trascorso il periodo tra due letture consecutive}
\PYG{+w}{      }\PYG{c+c1}{//if (read\PYGZus{}timer == 0UL) \PYGZob{}}
\PYG{+w}{      }\PYG{c+c1}{//  read\PYGZus{}timer = millis(); // inizializzazione timer}
\PYG{+w}{      }\PYG{c+c1}{//\PYGZcb{} else}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{millis}\PYG{p}{()}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{read\PYGZus{}timer}\PYG{+w}{ }\PYG{o}{\PYGZgt{}=}\PYG{+w}{ }\PYG{n}{read\PYGZus{}period}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n}{read\PYGZus{}timer}\PYG{+w}{ }\PYG{o}{+=}\PYG{+w}{ }\PYG{n}{read\PYGZus{}period}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento timer richiesta}
\PYG{+w}{        }\PYG{n}{state}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}TEMP\PYGZus{}REQ}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento stato}
\PYG{+w}{      }\PYG{p}{\PYGZcb{}}

\PYG{+w}{      }\PYG{c+c1}{// nessun nuovo dato disponibile}
\PYG{+w}{      }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}

\PYG{+w}{    }\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{} 1. sensore pronto per inviare la richiesta di lettura della temperatura}
\PYG{+w}{    }\PYG{k}{case}\PYG{+w}{ }\PYG{n+no}{SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}TEMP\PYGZus{}REQ}\PYG{p}{:}
\PYG{+w}{      }\PYG{c+c1}{// invio richiesta al sensore e verifica errori}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{requestTemperature}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{getError}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// recupero codice di errore}
\PYG{+w}{        }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// nessun nuovo dato disponibile}
\PYG{+w}{      }\PYG{p}{\PYGZcb{}}

\PYG{+w}{      }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// reset codice di errore}
\PYG{+w}{      }\PYG{n}{state}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{SHT20\PYGZus{}WAIT\PYGZus{}TEMP}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento stato}
\PYG{+w}{      }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{  }\PYG{c+c1}{// nessun nuovo dato disponibile}

\PYG{+w}{    }\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{} 2. sensore in attesa della risposta alla richiesta di lettura della temperatura}
\PYG{+w}{    }\PYG{k}{case}\PYG{+w}{ }\PYG{n+no}{SHT20\PYGZus{}WAIT\PYGZus{}TEMP}\PYG{p}{:}
\PYG{+w}{      }\PYG{c+c1}{// verifica presenza di nuovi dati disponibili per la temperatura}
\PYG{+w}{      }\PYG{c+c1}{// reqTempReady() non lancia errori (controlla solo un timer interno)}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{reqTempReady}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}

\PYG{+w}{        }\PYG{c+c1}{// recupero temperatura dal sensore e verifica errori}
\PYG{+w}{        }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{readTemperature}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{          }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{getError}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// recupero codice di errore}
\PYG{+w}{          }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// nessun nuovo dato disponibile}
\PYG{+w}{        }\PYG{p}{\PYGZcb{}}

\PYG{+w}{        }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// reset codice di errore}
\PYG{+w}{        }\PYG{n}{state}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}RH\PYGZus{}REQ}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento stato}
\PYG{+w}{      }\PYG{p}{\PYGZcb{}}
\PYG{+w}{      }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// nessun nuovo dato disponibile}

\PYG{+w}{    }\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{} 3. sensore pronto per inviare la richiesta di lettura dell\PYGZsq{}umidità}
\PYG{+w}{    }\PYG{k}{case}\PYG{+w}{ }\PYG{n+no}{SHT20\PYGZus{}READY\PYGZus{}FOR\PYGZus{}RH\PYGZus{}REQ}\PYG{p}{:}
\PYG{+w}{      }\PYG{c+c1}{// invio richiesta al sensore e verifica errori}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{requestHumidity}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{sensor}\PYG{p}{.}\PYG{n}{getError}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// recupero codice di errore}
\PYG{+w}{        }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// nessun nuovo dato disponibile}
\PYG{+w}{      }\PYG{p}{\PYGZcb{}}

\PYG{+w}{      }\PYG{n}{error}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// reset codice di errore}
\PYG{+w}{      }\PYG{n}{state}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{SHT20\PYGZus{}WAIT\PYGZus{}RH}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento stato}
\PYG{+w}{      }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// nessun nuovo dato disponibile}

\PYG{+w}{    }\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{} 4. sensore in attesa della risposta alla richiesta di lettura dell\PYGZsq{}umidità}
