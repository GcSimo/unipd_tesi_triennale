\PYG{c}{\PYGZpc{} La seguente funzione gestisce la comunicazione seriale dal lato computer con}
\PYG{c}{\PYGZpc{} la scheda Arduino installata sul prototipo di incubatore neonatale. Svolge}
\PYG{c}{\PYGZpc{} le seguenti operazioni:}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{}  1. legge i messaggi inviati dalla scheda Arduino tramite porta seriale}
\PYG{c}{\PYGZpc{}  2. filtra i messaggi in ingresso}
\PYG{c}{\PYGZpc{}  3. estrae i dati di interesse}
\PYG{c}{\PYGZpc{}  4. salva i dati in un file CSV opportunamente formattato}
\PYG{c}{\PYGZpc{}  5. mostra il grafico con l\PYGZsq{}andamento in tempo reale dei dati ricevuti}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{} La funzione accetta i seguenti parametri da riga di comando:}
\PYG{c}{\PYGZpc{}  \PYGZhy{} showPlot:}
\PYG{c}{\PYGZpc{}    permette di scegliere che parametri visualizzare nel grafico in tempo}
\PYG{c}{\PYGZpc{}    reale in base al valore passato come parametro:}
\PYG{c}{\PYGZpc{}     \PYGZhy{} 0 = nessun grafico}
\PYG{c}{\PYGZpc{}     \PYGZhy{} 1 = solo il grafico per la temperatura}
\PYG{c}{\PYGZpc{}     \PYGZhy{} 2 = solo il grafico per l\PYGZsq{}umidità}
\PYG{c}{\PYGZpc{}     \PYGZhy{} 3 = entrambi i grafici per la temperatura e l\PYGZsq{}umidità (default)}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{}  \PYGZhy{} portName:}
\PYG{c}{\PYGZpc{}    nome della porta seriale a cui è collegata la scheda Arduino, su macOS}
\PYG{c}{\PYGZpc{}    solitamente è \PYGZdq{}/dev/cu.usbserial\PYGZhy{}110\PYGZdq{} o \PYGZdq{}/dev/cu.usbmodem1101\PYGZdq{} (default)}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{}  \PYGZhy{} baudRate:}
\PYG{c}{\PYGZpc{}    baud rate della porta seriale, di default è 115200}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{}  \PYGZhy{} filename:}
\PYG{c}{\PYGZpc{}    nome del file CSV in cui salvare i dati, di default viene nominato con il}
\PYG{c}{\PYGZpc{}    timestamp dell\PYGZsq{}avvio del programma nel formato \PYGZdq{}data\PYGZus{}YYYYMMDD\PYGZus{}HHMMSS.csv\PYGZdq{}}
\PYG{c}{\PYGZpc{}    all\PYGZsq{}interno della cartella \PYGZdq{}serial\PYGZus{}read\PYGZdq{}}
\PYG{c}{\PYGZpc{}}

\PYG{k}{function}\PYG{+w}{ }\PYG{n+nf}{serial\PYGZus{}read}\PYG{p}{(}showPlot, portName, baudRate, filename\PYG{p}{)}
\PYG{+w}{	}\PYG{c}{\PYGZpc{}\PYGZpc{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{} parsing dei parametri e assegnazione dei valori di default \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{+w}{	}\PYG{c}{\PYGZpc{} tipo di grafico da mostrare (default = 3 \PYGZhy{} entrambi i grafici)}
\PYG{+w}{	}\PYG{k}{if}\PYG{+w}{ }\PYG{n+nb}{nargin}\PYG{+w}{ }\PYG{o}{\PYGZlt{}}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{n+nb}{isempty}\PYG{p}{(}\PYG{n}{showPlot}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{o}{\PYGZti{}}\PYG{n+nb}{ismember}\PYG{p}{(}\PYG{n}{showPlot}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{2}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{3}\PYG{p}{])}
\PYG{+w}{		}\PYG{n}{showPlot}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{l+m+mi}{3}\PYG{p}{;}
\PYG{+w}{	}\PYG{k}{end}

