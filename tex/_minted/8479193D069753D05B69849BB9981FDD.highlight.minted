\PYG{+w}{		}\PYG{n}{val}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{}N/A\PYGZdq{}}\PYG{p}{;}
\PYG{+w}{	}\PYG{k}{else}
\PYG{+w}{		}\PYG{n}{val}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n+nb}{string}\PYG{p}{(}\PYG{n}{m}\PYG{p}{\PYGZob{}}\PYG{l+m+mi}{1}\PYG{p}{\PYGZcb{});}
\PYG{+w}{	}\PYG{k}{end}
\PYG{k}{end}

\PYG{c}{\PYGZpc{} gestisce la chiusura sicura della porta seriale e del file CSV, viene}
\PYG{c}{\PYGZpc{} invocata in automatico al termine del programma (successo, errore o Ctrl+C)}
\PYG{k}{function}\PYG{+w}{ }\PYG{n+nf}{cleanUpRoutine}\PYG{p}{(}arduinoObj, fileID\PYG{p}{)}
