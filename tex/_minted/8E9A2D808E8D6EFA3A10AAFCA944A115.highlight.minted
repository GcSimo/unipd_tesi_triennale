\PYG{c+cp}{\PYGZsh{}define TEMP\PYGZus{}PID\PYGZus{}BIAS 0.0f }\PYG{c+c1}{// bias di feedforward}
\PYG{c+cp}{\PYGZsh{}define TEMP\PYGZus{}PID\PYGZus{}KP 55.0f  }\PYG{c+c1}{// guadagno proporzionale}
\PYG{c+cp}{\PYGZsh{}define TEMP\PYGZus{}PID\PYGZus{}KI 0.35f   }\PYG{c+c1}{// guadagno integrale}
\PYG{c+cp}{\PYGZsh{}define TEMP\PYGZus{}PID\PYGZus{}KD 1200.0f   }\PYG{c+c1}{// guadagno derivativo}
\PYG{c+cp}{\PYGZsh{}define TEMP\PYGZus{}PID\PYGZus{}KW 0.0f   }\PYG{c+c1}{// guadagno anti\PYGZhy{}windup}
\PYG{c+cp}{\PYGZsh{}define TEMP\PYGZus{}PID\PYGZus{}WINDUP CLAMPING }\PYG{c+c1}{// tipo di anti\PYGZhy{}windup}
