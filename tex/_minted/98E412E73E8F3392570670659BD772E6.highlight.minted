\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Imposta un errore nel codice di stato.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * @param error\PYGZus{}code flag del codice di errore da impostare}
\PYG{c+cm}{ * @return true errore impostato correttamente}
\PYG{c+cm}{ * @return false errore già presente, nessuna azione eseguita}
\PYG{c+cm}{ */}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{err\PYGZus{}set}\PYG{p}{(}\PYG{k+kt}{uint8\PYGZus{}t}\PYG{+w}{ }\PYG{n}{error\PYGZus{}code}\PYG{p}{);}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Rimuove un errore dal codice di stato.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * @param error\PYGZus{}code flag del codice di errore da rimuovere}
\PYG{c+cm}{ * @return true errore rimosso correttamente}
\PYG{c+cm}{ * @return false errore non presente, nessuna azione eseguita}
\PYG{c+cm}{ */}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{err\PYGZus{}clear}\PYG{p}{(}\PYG{k+kt}{uint8\PYGZus{}t}\PYG{+w}{ }\PYG{n}{error\PYGZus{}code}\PYG{p}{);}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Verifica se un errore è presente nel codice di stato.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * @param error\PYGZus{}code flag del codice di errore da verificare}
\PYG{c+cm}{ * @return true errore presente nel codice di stato}
\PYG{c+cm}{ * @return false errore non presente nel codice di stato}
\PYG{c+cm}{ */}
\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n+nf}{err\PYGZus{}check}\PYG{p}{(}\PYG{k+kt}{uint8\PYGZus{}t}\PYG{+w}{ }\PYG{n}{error\PYGZus{}code}\PYG{p}{);}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Aggiorna lo stato del led di allarme.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Il led di allarme viene acceso se è presente almeno un errore nel codice}
\PYG{c+cm}{ * di stato, altrimenti viene spento.}
\PYG{c+cm}{ */}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{update\PYGZus{}alarm\PYGZus{}led}\PYG{p}{();}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Verifica se ci sono errori temporizzati da rimuovere.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Verifica ogni timer degli errori temporizzati presenti}
\PYG{c+cm}{ */}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{update\PYGZus{}temporized\PYGZus{}errors}\PYG{p}{();}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Controlla se la temperatura misurata rientra nel range di sicurezza.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Verifica se la temperatura misurata rientra nel range di sicurezza definito}
\PYG{c+cm}{ * dal setpoint di temperatura e dalla soglia di errore TEMP\PYGZus{}ERR\PYGZus{}THLD.}
\PYG{c+cm}{ */}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{check\PYGZus{}temp\PYGZus{}range}\PYG{p}{();}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * @brief Controlla se l\PYGZsq{}umidità misurata rientra nel range di sicurezza.}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Verifica se l\PYGZsq{}umidità misurata rientra nel range di sicurezza definito}
\PYG{c+cm}{ * dal setpoint di umidità e dalla soglia di errore RH\PYGZus{}ERR\PYGZus{}THLD.}
\PYG{c+cm}{ */}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{check\PYGZus{}rh\PYGZus{}range}\PYG{p}{();}

\PYG{c+cp}{\PYGZsh{}endif }\PYG{c+c1}{// ERROR\PYGZus{}H}
