\PYG{c+c1}{// struct per memorizzare i messaggi da stampare sul display lcd}
\PYG{k}{struct}\PYG{+w}{ }\PYG{n+nc}{lcd\PYGZus{}message}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{k+kt}{char}\PYG{+w}{ }\PYG{n}{line1}\PYG{p}{[}\PYG{l+m+mi}{21}\PYG{p}{];}\PYG{+w}{ }\PYG{c+c1}{// prima riga del messaggio}
