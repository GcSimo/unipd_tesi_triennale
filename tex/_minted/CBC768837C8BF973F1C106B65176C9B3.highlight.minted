\PYG{c+c1}{// richiesta di spegnimento ventola di omogeneizzazione}
\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n+nf}{fan\PYGZus{}turn\PYGZus{}off}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
