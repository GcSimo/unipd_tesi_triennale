\PYG{+w}{  }\PYG{c+c1}{// verifica se è possibile spegnere la ventola di omogeneizzazione}
\PYG{+w}{  }\PYG{c+cp}{\PYGZsh{}if TEMP\PYGZus{}CTRL == PID \PYGZam{}\PYGZam{} RH\PYGZus{}CTRL == PID}
\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{status}\PYG{p}{.}\PYG{n}{heat\PYGZus{}relay}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{status}\PYG{p}{.}\PYG{n}{manual\PYGZus{}ctrl}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{status}\PYG{p}{.}\PYG{n}{temp\PYGZus{}pwm\PYGZus{}value}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{o}{!}\PYG{n}{status}\PYG{p}{.}\PYG{n}{rh\PYGZus{}pwm\PYGZus{}value}\PYG{p}{)))}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{c+cp}{\PYGZsh{}elif TEMP\PYGZus{}CTRL == PID \PYGZam{}\PYGZam{} RH\PYGZus{}CTRL != PID}
\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{status}\PYG{p}{.}\PYG{n}{heat\PYGZus{}relay}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{status}\PYG{p}{.}\PYG{n}{manual\PYGZus{}ctrl}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{o}{!}\PYG{n}{status}\PYG{p}{.}\PYG{n}{temp\PYGZus{}pwm\PYGZus{}value}\PYG{p}{))}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
