\PYG{+w}{  }\PYG{n}{digitalWrite}\PYG{p}{(}\PYG{n}{RH\PYGZus{}LED}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{LED\PYGZus{}OFF}\PYG{p}{);}\PYG{+w}{     }\PYG{c+c1}{// spegnimento LED umidificatore}
\PYG{+w}{  }\PYG{n}{status}\PYG{p}{.}\PYG{n}{rh\PYGZus{}relay}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nb}{false}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento stato umidificatore}

\PYG{+w}{  }\PYG{c+c1}{// richiesta di spegnimento ventola di omogeneizzazione}
\PYG{+w}{  }\PYG{n}{fan\PYGZus{}turn\PYGZus{}off}\PYG{p}{();}

