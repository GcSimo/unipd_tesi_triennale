\PYG{+w}{  }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{last\PYGZus{}rh\PYGZus{}on}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{millis}\PYG{p}{();}

\PYG{+w}{  }\PYG{c+c1}{// accensione avvenuta con successo}
\PYG{+w}{  }\PYG{k}{return}\PYG{+w}{ }\PYG{n+nb}{true}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}

\PYG{c+c1}{// spegnimento umidificatore}
\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n+nf}{rh\PYGZus{}turn\PYGZus{}off}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{c+c1}{// se l\PYGZsq{}umidificatore è già spento, restituisce false senza fare nulla}
