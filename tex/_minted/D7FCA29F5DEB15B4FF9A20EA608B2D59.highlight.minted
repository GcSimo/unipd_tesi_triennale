\PYG{+w}{        }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{millis}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento timer}
\PYG{+w}{        }\PYG{n}{set\PYGZus{}auto\PYGZus{}ctrl}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// attivazione controllo automatico}
