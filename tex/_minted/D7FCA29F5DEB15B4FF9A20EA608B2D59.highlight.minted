\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{status}\PYG{p}{.}\PYG{n}{temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{!=}\PYG{+w}{ }\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n}{millis}\PYG{p}{()}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{\PYGZgt{}=}\PYG{+w}{ }\PYG{n}{SP\PYGZus{}UPDATE\PYGZus{}DELAY}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{status}\PYG{p}{.}\PYG{n}{temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento setpoint precedente}
