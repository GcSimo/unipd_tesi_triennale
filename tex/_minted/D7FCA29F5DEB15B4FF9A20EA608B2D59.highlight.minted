\PYG{+w}{  }\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{} aggiornamento setpoint di temperatura e umidità \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{+w}{  }\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}

\PYG{+w}{  }\PYG{c+cm}{/**}
\PYG{c+cm}{   * @brief Aggiornamento dei setpoint di temperatura e umidità.}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * Il processo di aggiornamento del setpoint avviene nelle seguenti fasi:}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * 1. lettura del potenziometro ogni XX\PYGZus{}POT\PYGZus{}TIMER millisecondi}
\PYG{c+cm}{   * 2. controllo di soglia per eliminare disturbi e rumore elettrico}
\PYG{c+cm}{   * 3. calcolo del nuovo setpoint di temperatura o umidità e verifica che}
\PYG{c+cm}{   *    rientri nei limiti previsti XX\PYGZus{}MIN\PYGZus{}SP e XX\PYGZus{}MAX\PYGZus{}SP, con conseguente}
\PYG{c+cm}{   *    stampa del nuovo valore sul display lcd}
\PYG{c+cm}{   * 4. avvio del timer di ultima modifica del setpoint se il nuovo valore}
\PYG{c+cm}{   *    è diverso dal precedente e attivazione del controllo automatico}
\PYG{c+cm}{   * 5. aggiornamento del setpoint se il nuovo valore è diverso dal precedente}
\PYG{c+cm}{   *    e se è trascorso il tempo di ritardo previsto SETPOINT\PYGZus{}UPDATE\PYGZus{}DELAY}
\PYG{c+cm}{   *    e stampa del nuovo setpoint su serial monitor}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * Nel caso di potenziometri ad alta impedenza, è possibile che la lettura}
\PYG{c+cm}{   * analogica del valore del potenziometro venga influenzata dalla carica}
\PYG{c+cm}{   * residua del condensatore dell\PYGZsq{}ADC, provocando valori errati. Questo}
\PYG{c+cm}{   * fenomeno è denominato crosstalk dell\PYGZsq{}ADC. Per evitarlo, viene effettuata}
\PYG{c+cm}{   * una ulteriore lettura preliminare in modo che il condensatore abbia tempo}
\PYG{c+cm}{   * di caricarsi correttamente prima della lettura effettiva.}
\PYG{c+cm}{   */}

\PYG{+w}{  }\PYG{c+c1}{// controllo timer per lettura potenziometro temperatura}
\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{millis}\PYG{p}{()}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{temp\PYGZus{}pot}\PYG{+w}{ }\PYG{o}{\PYGZgt{}=}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}POT\PYGZus{}READ\PYGZus{}PERIOD}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{temp\PYGZus{}pot}\PYG{+w}{ }\PYG{o}{+=}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}POT\PYGZus{}READ\PYGZus{}PERIOD}\PYG{p}{;}\PYG{+w}{  }\PYG{c+c1}{// aggiornamento timer}
\PYG{+w}{    }\PYG{n}{analogRead}\PYG{p}{(}\PYG{n}{TEMP\PYGZus{}POT}\PYG{p}{);}\PYG{+w}{ }\PYG{c+c1}{// lettura per evitare crosstalk dell\PYGZsq{}ADC}
\PYG{+w}{    }\PYG{n}{pot\PYGZus{}read}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{analogRead}\PYG{p}{(}\PYG{n}{TEMP\PYGZus{}POT}\PYG{p}{);}\PYG{+w}{ }\PYG{c+c1}{// 1. lettura potenziometro temperatura}

\PYG{+w}{    }\PYG{c+c1}{// 2. controllo threshold}
\PYG{+w}{    }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{abs}\PYG{p}{(}\PYG{n}{status}\PYG{p}{.}\PYG{n}{temp\PYGZus{}pot\PYGZus{}value}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{pot\PYGZus{}read}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{\PYGZgt{}=}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}POT\PYGZus{}THLD}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{      }\PYG{n}{status}\PYG{p}{.}\PYG{n}{temp\PYGZus{}pot\PYGZus{}value}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{pot\PYGZus{}read}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento valore potenziometro temperatura}

\PYG{+w}{      }\PYG{c+c1}{// 3. calcolo nuovo setpoint di temperatura}
\PYG{+w}{      }\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{map}\PYG{p}{(}\PYG{n}{pot\PYGZus{}read}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}POT\PYGZus{}MIN}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}POT\PYGZus{}MAX}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}MIN\PYGZus{}SP}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}STEP\PYGZus{}SP}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}MAX\PYGZus{}SP}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}STEP\PYGZus{}SP}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}STEP\PYGZus{}SP}\PYG{p}{;}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{\PYGZlt{}}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}MIN\PYGZus{}SP}\PYG{p}{)}\PYG{+w}{ }\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}MIN\PYGZus{}SP}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// controllo limite inferiore}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}MAX\PYGZus{}SP}\PYG{p}{)}\PYG{+w}{ }\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{TEMP\PYGZus{}MAX\PYGZus{}SP}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// controllo limite superiore}

\PYG{+w}{      }\PYG{c+c1}{// stampa su display lcd}
\PYG{+w}{      }\PYG{n}{lcd\PYGZus{}new\PYGZus{}temp\PYGZus{}setpoint}\PYG{p}{(}\PYG{n}{new\PYGZus{}temp\PYGZus{}setpoint}\PYG{p}{);}

