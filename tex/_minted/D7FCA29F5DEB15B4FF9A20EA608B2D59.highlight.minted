\PYG{+w}{      }\PYG{c+c1}{// 4. controllo variazioni del setpoint di umidità}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{status}\PYG{p}{.}\PYG{n}{rh\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{!=}\PYG{+w}{ }\PYG{n}{new\PYGZus{}rh\PYGZus{}setpoint}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{rh\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{millis}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento timer}
\PYG{+w}{        }\PYG{n}{set\PYGZus{}auto\PYGZus{}ctrl}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// attivazione controllo automatico}
\PYG{+w}{      }\PYG{p}{\PYGZcb{}}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}
\PYG{+w}{  }\PYG{p}{\PYGZcb{}}

\PYG{+w}{  }\PYG{c+c1}{// 5. aggiornamento effettivo del setpoint di umidità}
\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{status}\PYG{p}{.}\PYG{n}{rh\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{!=}\PYG{+w}{ }\PYG{n}{new\PYGZus{}rh\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n}{millis}\PYG{p}{()}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{rh\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{\PYGZgt{}=}\PYG{+w}{ }\PYG{n}{SP\PYGZus{}UPDATE\PYGZus{}DELAY}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{status}\PYG{p}{.}\PYG{n}{rh\PYGZus{}setpoint}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{new\PYGZus{}rh\PYGZus{}setpoint}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// aggiornamento setpoint precedente}
\PYG{+w}{    }\PYG{n}{serial\PYGZus{}new\PYGZus{}rh\PYGZus{}setpoint}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// stampa su serial monitor}

\PYG{+w}{    }\PYG{c+c1}{// aggiornamento umidificatore tramite controllo ad isteresi}
