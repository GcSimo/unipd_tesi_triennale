\PYG{+w}{  }\PYG{c+cm}{/**}
\PYG{c+cm}{   * @brief Gestione del refill dell\PYGZsq{}acqua dell\PYGZsq{}umidificatore.}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * Il programma controlla periodicamente se è necessario effettuare un refill}
\PYG{c+cm}{   * dell\PYGZsq{}acqua. La procedura di test consiste nel verificare se l\PYGZsq{}intervallo}
\PYG{c+cm}{   * di tempo in cui l\PYGZsq{}umidificatore è stato acceso supera REFILL\PYGZus{}INTERVAL.}
\PYG{c+cm}{   * In caso affermativo, vuol dire che l\PYGZsq{}umidificatore ha consumato tutta}
\PYG{c+cm}{   * l\PYGZsq{}acqua che ne garantisce il corretto funzionamento ed è necessario}
\PYG{c+cm}{   * ricaricarne altra nell\PYGZsq{}apposita vaschetta.}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * Quando il programma nota la necessità di un refill, spegne l\PYGZsq{}umidificatore}
\PYG{c+cm}{   * accende il led di refill, mostra un messaggio di refill sul display lcd}
\PYG{c+cm}{   * e sul monitor seriale e blocca ulteriori accensioni dell\PYGZsq{}umidificatore.}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * Per far ripristinare il funzionamento dell\PYGZsq{}umidificatore, è necessario}
\PYG{c+cm}{   * effettuare il refill dell\PYGZsq{}acqua e successivamente riavviare l\PYGZsq{}incubatrice}
\PYG{c+cm}{   * neonatale dal tasto reset della scheda Arduino. In questo modo tutti i}
\PYG{c+cm}{   * contatori vengono azzerati.}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * Per calcolare il tempo totale in cui l\PYGZsq{}umidificatore è stato acceso}
\PYG{c+cm}{   * (che poi verrà confrontato con REFILL\PYGZus{}INTERVAL), si sommano i due}
\PYG{c+cm}{   * seguenti contributi:}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * 1. durata delle precedenti accensioni dell\PYGZsq{}umidificatore data dalla}
\PYG{c+cm}{   *   variabile timers.refill\PYGZus{}counter}
\PYG{c+cm}{   *}
\PYG{c+cm}{   * 2. tempo trascorso dall\PYGZsq{}ultima accensione, data dalla differenza}
\PYG{c+cm}{   *   (millis() \PYGZhy{} timers.last\PYGZus{}rh\PYGZus{}on) moltiplicata per lo stato attuale}
\PYG{c+cm}{   *   dell\PYGZsq{}umidificatore (status.rh\PYGZus{}relay), così da considerare solo}
\PYG{c+cm}{   *   il tempo trascorso se l\PYGZsq{}umidificatore è acceso}
\PYG{c+cm}{   */}

\PYG{+w}{  }\PYG{c+c1}{// verifica se è necessario un refill dell\PYGZsq{}acqua}
\PYG{+w}{  }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n}{status}\PYG{p}{.}\PYG{n}{refill\PYGZus{}led}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{refill\PYGZus{}counter}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{millis}\PYG{p}{()}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{timers}\PYG{p}{.}\PYG{n}{last\PYGZus{}rh\PYGZus{}on}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{status}\PYG{p}{.}\PYG{n}{rh\PYGZus{}relay}\PYG{+w}{ }\PYG{o}{\PYGZgt{}=}\PYG{+w}{ }\PYG{n}{REFILL\PYGZus{}INTERVAL}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{     }\PYG{n}{rh\PYGZus{}turn\PYGZus{}off}\PYG{p}{();}\PYG{+w}{                    }\PYG{c+c1}{// spegnimento umidificatore}
\PYG{+w}{     }\PYG{n}{lcd\PYGZus{}refill\PYGZus{}message}\PYG{p}{();}\PYG{+w}{             }\PYG{c+c1}{// stampa messaggio di refill sul display lcd}
\PYG{+w}{     }\PYG{n}{serial\PYGZus{}refill\PYGZus{}message}\PYG{p}{();}\PYG{+w}{          }\PYG{c+c1}{// stampa messaggio di refill su serial monitor}
\PYG{+w}{     }\PYG{n}{digitalWrite}\PYG{p}{(}\PYG{n}{REFILL\PYGZus{}LED}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{LED\PYGZus{}ON}\PYG{p}{);}\PYG{+w}{ }\PYG{c+c1}{// accensione led di refill}
\PYG{+w}{     }\PYG{n}{status}\PYG{p}{.}\PYG{n}{refill\PYGZus{}led}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nb}{true}\PYG{p}{;}\PYG{+w}{         }\PYG{c+c1}{// aggiornamento stato led di refill}
\PYG{+w}{  }\PYG{p}{\PYGZcb{}}


