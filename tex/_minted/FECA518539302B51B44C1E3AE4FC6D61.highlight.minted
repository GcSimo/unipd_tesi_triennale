\PYG{+w}{    }\PYG{n}{pid}\PYG{p}{.}\PYG{n}{derivative}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{pid}\PYG{p}{.}\PYG{n}{kd}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{c1}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{pid}\PYG{p}{.}\PYG{n}{sum2}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{c2}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{pid}\PYG{p}{.}\PYG{n}{sum3}\PYG{p}{);}
