\PYG{+w}{        }\PYG{n}{pid}\PYG{p}{.}\PYG{n}{integral}\PYG{+w}{ }\PYG{o}{+=}\PYG{+w}{ }\PYG{n}{integral\PYGZus{}contrib}\PYG{p}{;}
