Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z0", ",", "z1", ",", "p0", ",", " ", "p1"}], "}"}], "*", 
   "("}]}]], "Input",
 CellChangeTimes->{{3.997516464876803*^9, 3.997516471459454*^9}, {
  3.9978498676094503`*^9, 3.997849874823625*^9}, {3.9978542246270857`*^9, 
  3.9978542262941*^9}},
 CellLabel->
  "In[2459]:=",ExpressionUUID->"a798e983-6a5e-46ce-875c-b8be12d2c4ea"],

