Notebook[{

Cell[CellGroupData[{
Cell["calcolo zeri-poli - incubatrice", "Title",
 CellChangeTimes->{{3.997515692931858*^9, 
  3.99751570334361*^9}},ExpressionUUID->"972d17a9-2fd5-46af-b603-\
82583f4ce891"],

Cell[BoxData[{
 RowBox[{"kp", ":=", "x"}], "\[IndentingNewLine]", 
 RowBox[{"ki", ":=", "0.5"}], "\[IndentingNewLine]", 
 RowBox[{"kd", ":=", "500"}], "\[IndentingNewLine]", 
 RowBox[{"a", ":=", "0.0012"}]}], "Input",
 CellChangeTimes->{{3.9975157078636847`*^9, 3.9975157563423777`*^9}, {
  3.997516482171804*^9, 3.9975165115880203`*^9}, {3.997516948515875*^9, 
  3.997516953765431*^9}, {3.997517000584963*^9, 3.997517009562858*^9}, {
  3.997517152558342*^9, 3.99751718128408*^9}},
 CellLabel->
  "In[192]:=",ExpressionUUID->"a3656027-166c-4505-8d94-270163d0e0b6"],

Cell["\<\
G(s) = K/(s-a)
C(s) = (k_d * s^2 + k_p * s + k_i)/s
L(s) = (K*k_d * s^2 + K*k_p * s + K*k_i)/(s * (s - a)) = (D * s^2 + P * s + \
I)/(s * (s - a))
W_r(s) = L(s) / (1 + L(s)) = ((D * s^2 + P * s + I) / ((D + 1) * s^2 + (P - \
a) * s + I)
z0 = (-P + Sqrt[P^2 - 4*D*I]) /  2D
z1 = (-P - Sqrt[P^2 - 4*D*I]) /  2D
p0  = (-(P-a) + Sqrt[(P-a)^2 - 4*(D+1)*I]) /  2(D+1)
p1  = (-(P-a) + Sqrt[(P-a)^2 - 4*(D+1)*I]) /  2(D+1)\
\>", "Text",
 CellChangeTimes->{{3.997515836475645*^9, 3.997515930278698*^9}, {
  3.99751616567444*^9, 3.997516242728962*^9}, {3.997516301133225*^9, 
  3.997516392497819*^9}},ExpressionUUID->"f6d0d41c-35bb-4469-9c59-\
39187d045ece"],

Cell[BoxData[{
 RowBox[{"z0", ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "kp"}], "+", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"kp", "^", "2"}], " ", "-", " ", 
       RowBox[{"4", "*", "kd", "*", "ki"}]}], "]"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", "*", "kd"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"z1", ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "kp"}], "-", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"kp", "^", "2"}], " ", "-", " ", 
       RowBox[{"4", "*", "kd", "*", "ki"}]}], "]"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", "*", "kd"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"p0", ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"kp", "-", "a"}], ")"}]}], "+", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"kp", "-", "a"}], ")"}], "^", "2"}], " ", "-", " ", 
       RowBox[{"4", "*", 
        RowBox[{"(", 
         RowBox[{"kd", "+", "1"}], ")"}], "*", "ki"}]}], "]"}]}], ")"}], "/", 
   
   RowBox[{"(", 
    RowBox[{"2", "*", 
     RowBox[{"(", 
      RowBox[{"kd", "+", "1"}], ")"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"p1", ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"kp", "-", "a"}], ")"}]}], "-", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"kp", "-", "a"}], ")"}], "^", "2"}], " ", "-", " ", 
       RowBox[{"4", "*", 
        RowBox[{"(", 
         RowBox[{"kd", "+", "1"}], ")"}], "*", "ki"}]}], "]"}]}], ")"}], "/", 
   
   RowBox[{"(", 
    RowBox[{"2", "*", 
     RowBox[{"(", 
      RowBox[{"kd", "+", "1"}], ")"}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.997515809513812*^9, 3.997515824504496*^9}, {
  3.997516394963676*^9, 3.997516456178404*^9}},
 CellLabel->
  "In[196]:=",ExpressionUUID->"0e5bf594-0e98-4fbf-9e0b-a030735b514b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"z0", ",", " ", "p0", ",", " ", "z1", ",", " ", "p1"}], 
  "}"}]], "Input",
 CellChangeTimes->{{3.997516464876803*^9, 3.997516471459454*^9}},
 CellLabel->
  "In[200]:=",ExpressionUUID->"a798e983-6a5e-46ce-875c-b8be12d2c4ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", "x"}], "+", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", "1000.`"}], "+", 
       SuperscriptBox["x", "2"]}]]}], "1000"], ",", 
   FractionBox[
    RowBox[{"0.0012`", "\[VeryThinSpace]", "+", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", "1002.`"}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "0.0012`"}], "+", "x"}], ")"}], "2"]}]], "-", "x"}], 
    "1002"], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "x"}], "-", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", "1000.`"}], "+", 
       SuperscriptBox["x", "2"]}]]}], "1000"], ",", 
   FractionBox[
    RowBox[{"0.0012`", "\[VeryThinSpace]", "-", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", "1002.`"}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "0.0012`"}], "+", "x"}], ")"}], "2"]}]], "-", "x"}], 
    "1002"]}], "}"}]], "Output",
 CellChangeTimes->{{3.9975164721875753`*^9, 3.997516514955112*^9}, {
  3.997516950921358*^9, 3.997516957059496*^9}, {3.997517003130576*^9, 
  3.997517011753071*^9}, {3.997517156749179*^9, 3.997517183070959*^9}},
