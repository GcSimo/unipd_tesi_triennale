Cell["----------", "Text",
 CellChangeTimes->{{3.997852501334978*^9, 
  3.9978525193702*^9}},ExpressionUUID->"a9e87003-873c-4b12-9e9d-48ebe17ca828"],

Cell["\<\
G(s) = b/(s-a)
C(s) = (k_d * s^2 + k_p * s + k_i)/s
L(s) = (b*k_d * s^2 + b*k_p * s + b*k_i)/(s * (s - a)) = (D * s^2 + P * s + \
I)/(s * (s - a))
W_r(s) = L(s) / (1 + L(s)) = ((D * s^2 + P * s + I) / ((D + 1) * s^2 + (P - \
a) * s + I)
z0 = (-P + Sqrt[P^2 - 4*D*I]) /  2D
z1 = (-P - Sqrt[P^2 - 4*D*I]) /  2D
p0  = (-(P-a) + Sqrt[(P-a)^2 - 4*(D+1)*I]) /  2(D+1)
p1  = (-(P-a) + Sqrt[(P-a)^2 - 4*(D+1)*I]) /  2(D+1)\
\>", "Text",
 CellChangeTimes->{{3.997515836475645*^9, 3.997515930278698*^9}, {
  3.99751616567444*^9, 3.997516242728962*^9}, {3.997516301133225*^9, 
  3.997516392497819*^9}, {3.997849780111958*^9, 
  3.997849786420961*^9}},ExpressionUUID->"f6d0d41c-35bb-4469-9c59-\
39187d045ece"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"z0", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "b"}], "*", "kp"}], "+", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"b", "*", 
           RowBox[{"kp", "^", "2"}]}], " ", "-", " ", 
          RowBox[{"4", "*", "b", "*", "kd", "*", "b", "*", "ki"}]}], "]"}]}], 
       ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "b", "*", "kd"}], ")"}]}], "\[IndentingNewLine]", 
     "z1"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "b"}], "*", "kp"}], "-", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"b", "*", 
            RowBox[{"kp", "^", "2"}]}], " ", "-", " ", 
           RowBox[{"4", "*", "b", "*", "kd", "*", "b", "*", "ki"}]}], "]"}]}],
         ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "b", "*", "kd"}], ")"}]}], "\[IndentingNewLine]", 
      "p0"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"b", "*", "kp"}], "-", "a"}], ")"}]}], "+", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"b", "*", "kp"}], "-", "a"}], ")"}], "^", "2"}], " ", "-",
             " ", 
            RowBox[{"4", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"b", "*", "kd"}], "+", "1"}], ")"}], "*", "b", "*", 
             "ki"}]}], "]"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "*", "kd"}], "+", "1"}], ")"}]}], ")"}]}], "\[IndentingNewLine]",
        "p1"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"b", "*", "kp"}], "-", "a"}], ")"}]}], "-", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"b", "*", "kp"}], "-", "a"}], ")"}], "^", "2"}], " ", "-",
             " ", 
            RowBox[{"4", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"b", "*", "kd"}], "+", "1"}], ")"}], "*", "b", "*", 
             "ki"}]}], "]"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "*", "kd"}], "+", "1"}], ")"}]}], ")"}]}], "*", 
       "("}]}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.997515809513812*^9, 3.997515824504496*^9}, {
  3.997516394963676*^9, 3.997516456178404*^9}, {3.997849795330303*^9, 
