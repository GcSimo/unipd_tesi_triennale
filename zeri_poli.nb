 RowBox[{"(*", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p0", ",", " ", "p1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9975170889540167`*^9, 3.997517122685583*^9}, {
  3.997849995231749*^9, 3.997850018972529*^9}, {3.997854200545762*^9, 
  3.9978542032394953`*^9}},
 CellLabel->
  "In[2459]:=",ExpressionUUID->"96439628-e4bc-4896-b523-f770388d752e"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"wn", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"b", "*", "ki"}], "]"}], "\[IndentingNewLine]", "e"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"b", "*", "kp"}], "-", "a"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "wn"}], ")"}]}], "\[IndentingNewLine]", "mp"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "Pi"}], "*", 
         RowBox[{"e", "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
